{
  "name": "rayzee-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "rayzee",
    "app"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm -w @rayzee/app run dev",
    "dev:local": "node scripts/dev-local-runtime.mjs",
    "build": "npm -w rayzee run build && npm -w @rayzee/app run build",
    "build:app": "npm -w @rayzee/app run build",
    "build:engine": "npm -w rayzee run build",
    "lint": "eslint .",
    "lint-fix": "npx eslint --fix",
    "preview": "npm -w @rayzee/app run preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node bench/runner/cli.js run",
    "bench:quality": "node bench/runner/cli.js quality",
    "bench:studio": "node bench/runner/upstreamImprovements.js",
    "bench:denoise": "node bench/runner/cli.js denoise",
    "bench:freeze": "node bench/runner/cli.js freeze",
    "bench:memory": "node bench/runner/cli.js memory",
    "bench:perf": "node bench/runner/cli.js perf",
    "bench:kernels": "node bench/runner/cli.js kernels",
    "bench:upscale": "node bench/runner/cli.js upscale",
    "bench:bless": "node bench/runner/cli.js bless",
    "bench:calibrate": "node bench/runner/cli.js calibrate",
    "bench:ab": "node bench/runner/cli.js ab",
    "bench:list": "node bench/runner/cli.js list",
    "release": "cross-env $(cat .env | xargs) semantic-release --no-ci",
    "bench:lut": "node bench/tools/gen-dfg-lut.mjs",
    "dev:previs": "vite --config app/vite.previs.config.js",
    "build:previs": "vite build --config app/vite.previs.config.js",
    "test:previs": "vitest run tests/unit/previs",
    "test:previs:storage": "node tests/integration/previs/studentRepository.browser.mjs && node tests/integration/previs/studentAccountStorage.browser.mjs",
    "test:previs:browser": "node tests/browser/previs/rasterDiagnostic.browser.mjs",
    "test:previs:soak": "node tests/browser/previs/rasterDiagnostic.browser.mjs --soak",
    "test:previs:renderer-parity": "node tests/browser/previs/rendererParity.browser.mjs",
    "test:previs:editor": "node tests/browser/previs/studentEditor.browser.mjs",
    "test:previs:voiceover": "node tests/browser/previs/studentVoiceover.browser.mjs",
    "test:previs:playback-cuts": "node tests/browser/previs/studentPlaybackCuts.browser.mjs",
    "test:previs:preset-editor": "node tests/browser/previs/adminPresets.browser.mjs",
    "test:previs:preset-storage": "node tests/integration/previs/localPresetRepository.browser.mjs",
    "test:previs:ui": "node tests/browser/previs/studentUI.browser.mjs",
    "test:previs:offline": "node tests/browser/previs/studentOffline.browser.mjs",
    "test:previs:offline:editor": "node tests/browser/previs/studentRealEditorOffline.browser.mjs",
    "test:previs:accounts": "node tests/browser/previs/studentAccounts.browser.mjs",
    "test:previs:admin-users": "node tests/browser/previs/adminUsers.browser.mjs",
    "test:previs:admin-review": "node tests/browser/previs/adminReviewMedia.browser.mjs",
    "test:previs:backend": "npm --prefix backend test",
    "test:previs:sync": "node tests/integration/previs/studentSyncBackend.browser.mjs && node tests/integration/previs/studentAccountSync.browser.mjs",
    "test:previs:admin": "node tests/browser/previs/adminBaseline.browser.mjs",
    "dev:previs:backend": "npm --prefix backend run dev",
    "test:previs:scene": "node tests/browser/previs/realScene.browser.mjs",
    "test:previs:scene:soak": "node tests/browser/previs/realScene.browser.mjs --soak",
    "test:previs:catalogue": "node tests/integration/previs/studentCatalogue.browser.mjs",
    "test:previs:published-scene": "node tests/integration/previs/studentPublishedScene.browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.1",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.9.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0",
    "semantic-release": "^25.0.9",
    "semantic-release-export-data": "^1.2.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
